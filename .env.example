# fixture (default, no keys needed) | supabase
SLEUTH_DATA_MODE=fixture

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (supabase mode only). Leave blank in fixture mode.
NEXT_PUBLIC_SUPABASE_URL=
# Public by design. Safe only with Row Level Security on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and worker only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=video-assets

# Providers: mock | (real provider names are chosen by the media owner)
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=
VIDEO_ANALYSIS_PROVIDER=mock
VIDEO_ANALYSIS_API_KEY=

# Limits
MAX_VIDEO_SECONDS=180
MAX_FRAMES_PER_VIDEO=60
DAILY_ANALYSIS_LIMIT_PER_USER=5
