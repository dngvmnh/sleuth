# fixture (default, no keys needed) | supabase
SLEUTH_DATA_MODE=fixture

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (supabase mode only). Leave blank in fixture mode.
NEXT_PUBLIC_SUPABASE_URL=
# Public by design. Safe only with Row Level Security on.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and worker only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=video-assets

# Providers (ADR 0007): transcription = mock | deepgram, video analysis = mock | gemini.
# Keys are secrets: worker only, never committed, never logged.
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=nova-3
VIDEO_ANALYSIS_PROVIDER=mock
VIDEO_ANALYSIS_API_KEY=
VIDEO_ANALYSIS_MODEL=gemini-3.8-flash

# Limits
MAX_VIDEO_SECONDS=180
MAX_FRAMES_PER_VIDEO=60
# Largest video the worker downloads (matches the 50 MiB storage bucket limit).
MAX_VIDEO_BYTES=52428800
DAILY_ANALYSIS_LIMIT_PER_USER=5

# Worker: anonymous-project purge (ADR 0008)
RETENTION_INTERVAL_MS=3600000
ANONYMOUS_RETENTION_DAYS=7

# Worker, supabase mode: the mock providers return the golden fixture whatever the video shows,
# so the worker refuses them unless this is 1. Local testing only.
ALLOW_MOCK_PROVIDERS=0
