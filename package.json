{
  "name": "sleuth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QA workspace for software demo videos.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sleuth/web dev",
    "worker": "pnpm --filter @sleuth/worker start",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages,tests,scripts,fixtures}/**/*.{ts,tsx,css,mjs}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"{apps,packages,tests,scripts,fixtures}/**/*.{ts,tsx,css,mjs}\" \"*.{ts,mjs}\"",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.property.test.ts\" --exclude \"**/node_modules/**\" --exclude \"tests/e2e/**\"",
    "test:property": "vitest run .property.test.ts",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build",
    "check:contracts": "vitest run tests/contract && tsx scripts/generate-openapi.ts --check",
    "db:generate": "pnpm --filter @sleuth/db generate",
    "db:migrate": "pnpm --filter @sleuth/db migrate",
    "db:seed": "pnpm --filter @sleuth/db seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.65.0",
    "@sleuth/contracts": "workspace:*",
    "@sleuth/db": "workspace:*",
    "@sleuth/domain": "workspace:*",
    "@sleuth/evidence-engine": "workspace:*",
    "@sleuth/media": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
